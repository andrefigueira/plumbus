# Reference-image generation with GPT Image 2.
OPENAI_API_KEY=

# Your own GPU workers on RunPod Serverless. See deploy/runpod/README.md.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Your actual $/hr, used to attribute cost per job. Blank uses the L40S Flex list price.
PLUMBUS_RUNPOD_USD_PER_HOUR=

# Third-party hosted 3D fallback. Only needed if you use the `fal` backend.
FAL_KEY=

# Where generated assets land.
PLUMBUS_OUTPUT_DIR=./outputs
PLUMBUS_UPLOAD_DIR=./uploads

# Local engine checkouts. Point these at the cloned repos.
PLUMBUS_TRELLIS_PATH=./vendor/trellis-mac
PLUMBUS_HUNYUAN_PATH=./vendor/Hunyuan3D-2.1-mac

# Python interpreter used to run the local engines (they need their own venv).
PLUMBUS_TRELLIS_PYTHON=./vendor/trellis-mac/.venv/bin/python
PLUMBUS_HUNYUAN_PYTHON=./vendor/Hunyuan3D-2.1-mac/.venv/bin/python

# Default backend: trellis | hunyuan | fal
PLUMBUS_DEFAULT_BACKEND=trellis

# Server
PLUMBUS_HOST=127.0.0.1
PLUMBUS_PORT=8420
